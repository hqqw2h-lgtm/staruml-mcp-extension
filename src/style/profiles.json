{
  "uml-standard": {
    "name": "uml-standard",
    "description": "UML 2.5 conventions on StarUML's own look: PascalCase types, camelCase members, UPPER_CASE constants and literals, 'Verb noun' use cases, lowercase packages; rectilinear edges; the layout each kind reads best in.",
    "strict": false,
    "blockSaveOnErrors": false,
    "naming": {
      "classifier": {
        "pattern": "PascalCase",
        "fix": "pascal"
      },
      "attribute": {
        "pattern": "camelCase",
        "fix": "camel"
      },
      "operation": {
        "pattern": "camelCase",
        "fix": "camel"
      },
      "constant": {
        "pattern": "UPPER_CASE",
        "fix": "upperSnake"
      },
      "literal": {
        "pattern": "UPPER_CASE",
        "fix": "upperSnake"
      },
      "usecase": {
        "pattern": "Verb noun",
        "fix": "none"
      },
      "package": {
        "pattern": "lowercase",
        "fix": "none"
      }
    },
    "visuals": {
      "kinds": {},
      "stereotypes": {},
      "edges": {},
      "show": {},
      "grid": {
        "size": 10,
        "snap": true
      }
    },
    "layout": {
      "presets": {
        "class": "hierarchy-down",
        "package": "hierarchy-down",
        "activity": "flow-down",
        "statemachine": "flow-right",
        "erd": "hierarchy-right"
      },
      "spacing": {
        "node": 50,
        "rank": 70
      },
      "maxElements": 30,
      "page": {
        "width": 1600,
        "height": 1200
      },
      "labelWrap": 220
    },
    "rules": {
      "requireMultiplicities": true,
      "allowedRelationships": {
        "class": [
          "association",
          "directed",
          "aggregation",
          "composition",
          "generalization",
          "realization",
          "dependency"
        ],
        "package": ["dependency"],
        "usecase": ["association", "directed", "generalization", "dependency"]
      },
      "documentationRequired": [],
      "forbidDuplicateNames": true
    },
    "quality": {
      "minScore": 80,
      "maxIterations": 3,
      "thresholds": {}
    },
    "policy": {
      "classDiagrams": "views",
      "hideGetters": false,
      "neighbours": true,
      "packageOverview": true
    }
  },
