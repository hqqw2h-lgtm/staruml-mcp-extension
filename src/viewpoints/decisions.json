{
  "$schema": "./decisions.schema.json",
  "version": 2,
  "rules": [
    {
      "id": "D01",
      "viewpoint": "lifecycle",
      "kind": "statemachine",
      "template": "lifecycle-states",
      "phrases": [
        "lifecycle",
        "life cycle",
        "state machine",
        "statechart",
        "state",
        "states",
        "status",
        "statuses",
        "transition",
        "transitions",
        "lifecycles"
      ],
      "weak": ["becomes", "goes through"],
      "scopes": ["model", "package", "class", "statemachine"],
      "reason": "States and the events between them are what a state machine shows, for one kind of object."
    },
    {
      "id": "D02",
      "viewpoint": "data",
      "kind": "erd",
      "template": "data-erd",
      "phrases": [
        "data model",
        "database",
        "schema",
        "table",
        "tables",
        "erd",
        "entity relationship",
        "persistence",
        "persisted",
        "stored",
        "storage",
        "column",
        "columns",
        "foreign key",
        "records",
        "record"
      ],
      "scopes": ["model"],
      "reason": "What is stored and how records relate is an entity-relationship view of the data model."
    },
    {
      "id": "D03",
      "viewpoint": "deployment",
      "kind": "deployment",
      "template": "deployment-nodes",
      "phrases": [
        "deployment",
        "deployed",
        "deploy",
        "infrastructure",
        "hosting",
        "hosted",
        "runs on",
        "run on",
        "server",
        "servers",
        "node",
        "nodes",
        "cluster",
        "kubernetes",
        "docker",
        "topology",
        "installation",
        "environment",
        "environments",
        "deployments"
      ],
      "scopes": ["model"],
      "reason": "Where the system runs is a deployment view: nodes, what is deployed on them, and the links between them."
    },
    {
      "id": "D04",
      "viewpoint": "runtime",
      "kind": "communication",
      "template": "runtime-communication",
      "phrases": [
        "communication diagram",
        "who talks to whom",
        "talks to",
        "collaboration",
        "collaborators",
        "object links"
      ],
      "scopes": ["model", "package", "class", "interaction"],
      "reason": "Who exchanges messages with whom, without the timeline, is a communication diagram of the scenario."
    },
    {
      "id": "D05",
      "viewpoint": "runtime",
      "kind": "activity",
      "template": "runtime-activity",
      "phrases": [
        "activity",
        "workflow",
        "work flow",
        "process",
        "procedure",
        "algorithm",
        "steps",
        "decision points",
        "business process",
        "pipeline",
        "execution",
        "activities",
        "workflows",
        "processes",
        "step",
        "step by step",
        "procedures",
        "pipelines",
        "executed",
        "execute"
      ],
      "scopes": ["model"],
      "reason": "Steps, decisions and parallel branches across parts are an activity, a lane per part."
    },
    {
      "id": "D06",
      "viewpoint": "runtime",
      "kind": "sequence",
      "template": "runtime-sequence",
      "phrases": [
        "sequence",
        "interaction",
        "interactions",
        "message",
        "messages",
        "call",
        "calls",
        "what happens",
        "scenario",
        "scenarios",
        "request flow",
        "handled",
        "handles",
        "processed",
        "processing",
        "ingestion",
        "login",
        "runtime",
        "sequences"
      ],
      "weak": ["how does", "how do", "how is", "flow", "works", "work"],
      "scopes": ["model", "package", "class", "interaction"],
      "reason": "What happens in order between the parts when something starts a scenario is a sequence of messages."
    },
    {
      "id": "D07",
      "viewpoint": "actors-goals",
      "kind": "mindmap",
      "template": "actors-goals-features",
      "phrases": [
        "feature",
        "features",
        "feature tree",
        "capability",
        "capabilities",
        "functionality",
        "offerings"
      ],
      "scopes": ["model"],
      "reason": "What the system offers, grouped, is a feature tree."
    },
    {
      "id": "D08",
      "viewpoint": "actors-goals",
      "kind": "usecase",
      "template": "actors-goals-usecases",
      "phrases": [
        "use case",
        "use cases",
        "usecase",
        "goal",
        "goals",
        "actor",
        "actors",
        "who can",
        "what can users",
        "what users",
        "user story",
        "user stories",
        "role",
        "roles",
        "functional scope",
        "what can",
        "can do",
        "tasks",
        "permissions"
      ],
      "scopes": ["model", "actor", "usecase"],
      "reason": "Who needs the system for what is a use case view: actors and their goals inside the system boundary."
    },
    {
      "id": "D09",
      "viewpoint": "context",
      "kind": "c4",
      "template": "context-landscape",
      "phrases": [
        "context",
        "system context",
        "big picture",
        "landscape",
        "external system",
        "external systems",
        "who uses the system",
        "boundary",
        "surroundings",
        "integration",
        "integrations"
      ],
      "weak": ["overview"],
      "scopes": ["model"],
      "reason": "The system among its users and neighbours, as one box, is a context view."
    },
    {
      "id": "D10",
      "viewpoint": "container",
      "kind": "c4",
      "template": "container-overview",
      "phrases": [
        "container",
        "containers",
        "service",
        "services",
        "microservice",
        "microservices",
        "application",
        "applications",
        "technology",
        "technologies",
        "tech stack",
        "architecture",
        "high level architecture",
        "building blocks"
      ],
      "scopes": ["model"],
      "reason": "The running parts of the system and their technology are a container view."
    },
    {
      "id": "D11",
      "viewpoint": "component",
      "kind": "package",
      "template": "component-packages",
      "phrases": [
        "component",
        "components",
        "module",
        "modules",
        "package",
        "packages",
        "layer",
        "layers",
        "layering",
        "dependencies between",
        "dependency structure",
        "package dependencies",
        "decomposition",
        "subsystem",
        "subsystems"
      ],
      "scopes": ["model", "package"],
      "reason": "How the system divides into parts and which depends on which is a package dependency view."
    },
    {
      "id": "D12",
      "viewpoint": "code",
      "kind": "class",
      "template": "code-classes",
      "phrases": [
        "class",
        "classes",
        "class diagram",
        "domain model",
        "object model",
        "object design",
        "type hierarchy",
        "inheritance",
        "interface",
        "interfaces",
        "types",
        "code structure",
        "attributes",
        "operations",
        "api"
      ],
      "scopes": ["model", "package", "class"],
      "reason": "Types and their structural relationships are a class diagram."
    }
  ],
  "defaults": {
    "package": "D12",
    "class": "D12",
    "interaction": "D06",
    "statemachine": "D01",
    "actor": "D08",
    "usecase": "D08"
  }
}
