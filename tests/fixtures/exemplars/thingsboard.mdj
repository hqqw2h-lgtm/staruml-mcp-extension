_parent":{"$ref":"AAAAAAGhEfauSrawpTg="},"name":"Kafka partitioned queues"},{"_type":"MMNode","_id":"AAAAAAGhEfazlbizGMw=","_parent":{"$ref":"AAAAAAGhEfauSrawpTg="},"name":"Microservice deployment"},{"_type":"MMNode","_id":"AAAAAAGhEfazsLi9Cx0=","_parent":{"$ref":"AAAAAAGhEfauSrawpTg="},"name":"Edge computing"},{"_type":"MMNode","_id":"AAAAAAGhEfazx7jHsHA=","_parent":{"$ref":"AAAAAAGhEfauSrawpTg="},"name":"Version control"},{"_type":"MMNode","_id":"AAAAAAGhEfaz3bjRsws=","_parent":{"$ref":"AAAAAAGhEfauSrawpTg="},"name":"AI models and agents"}]}],"documentation":"Open-source IoT platform: devices connect over MQTT/HTTP/CoAP/LwM2M/SNMP transports, messages flow through a queue into a per-tenant actor-based rule engine, results land in SQL/Timescale/Cassandra storage, and a REST/WebSocket API plus an Angular UI serve tenants and customers.","tags":[{"_type":"Tag","_id":"AAAAAAGhEfV8RyaqU8A=","_parent":{"$ref":"AAAAAAGhEfV8QianRzo="},"name":"mcp.modelViews","kind":"string","value":"{\"classViews\":[{\"name\":\"Class - Entities and DAO\",\"contexts\":[\"domain\",\"persistence\"],\"exclude\":[\"TimeseriesDao\"],\"note\":\"domain entities plus the DAO/service layer\"},{\"name\":\"Class - Application Services\",\"contexts\":[\"services\"]},{\"name\":\"Class - Rule Engine\",\"contexts\":[\"ruleapi\",\"rulenodes\"],\"also\":[\"TbMsg\",\"TbMsgMetaData\"]},{\"name\":\"Class - Transport\",\"contexts\":[\"transportapi\",\"transports\"]},{\"name\":\"Class - Actor System\",\"contexts\":[\"actorfw\",\"actors\"],\"also\":[\"TbNode\",\"TbContext\"]},{\"name\":\"Class - Security\",\"contexts\":[\"security\"]}],\"useCaseViews\":[{\"name\":\"Use Cases - Tenant Administrator\",\"actor\":\"Tenant Administrator\",\"cases\":[\"Log in\",\"Manage devices and profiles\",\"Manage credentials\",\"Provision device\",\"Design rule chains\",\"Debug rule nodes\",\"Build dashboards\",\"Manage customers and users\",\"Assign entities to customer\",\"Handle alarms\",\"Acknowledge alarm\",\"Send RPC comman